# Environment
ENVIRONMENT=local
DEBUG=true

# Database
DB_HOST=database.havrilesko.internal
DB_PORT=5432
DB_NAME=django
DB_USER=postgres
DB_PASSWORD=

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# JWT Configuration
# Paste full RSA private key here or base64-encoded version
RSA_PRIVATE_KEY=
JWT_TTL_ACCESS=5 minutes
JWT_TTL_REFRESH=30 days

# Domains
FRONTEND_DOMAIN=havrilesko.lndo.site
BACKEND_DOMAIN=havrilesko-api.lndo.site
JWT_ISSUER_DOMAIN=havrilesko-api.lndo.site

# CORS (list format for Python)
# Will be parsed as: ["http://localhost:3000", "https://havrilesko.lndo.site"]
# Or leave as default in config.py
